# Azure Code Interpreter MCP — environment template. Copy to a 0600 file and
# point the service at it with AZCI_ENV_FILE.

# Azure OpenAI key for the hymafoundry resource (only deployment: gpt-6-luna).
AZURE_AI_KEY=

# Shared secret LibreChat sends as the X-Azci-Token header.
AZCI_MCP_TOKEN=

# Optional overrides (defaults shown).
AZCI_AZURE_BASE_URL=https://hymafoundry.openai.azure.com/openai/v1
AZCI_MODEL=gpt-6-luna
AZCI_MCP_HOST=172.17.0.1
AZCI_MCP_PORT=8935
AZCI_DOWNLOAD_HOST=127.0.0.1
AZCI_DOWNLOAD_PORT=8936
AZCI_ARTIFACT_DIR=/home/hyma/.local/share/azure-ci-mcp/artifacts
AZCI_RETENTION_DAYS=7
# Keep a local 7-day copy of outputs plus signed links. false = pass-through only.
AZCI_STORE_ARTIFACTS=true
AZCI_DEFAULT_TIMEOUT_S=180
AZCI_MAX_TIMEOUT_S=600
AZCI_MAX_CONCURRENCY=4
AZCI_CONTAINER_IDLE_TTL_S=1080
